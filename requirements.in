# Every Python dependency the gates and CI need. Kept small on purpose: the
# gates are stdlib plus a YAML parser, and the two tools CI installs to check
# them.
pyyaml
yamllint
coverage
zizmor
# Linter and type checker for the gate scripts. types-PyYAML is what makes the
# type check see through yaml.safe_load, which every gate calls.
ruff
mypy
types-PyYAML
